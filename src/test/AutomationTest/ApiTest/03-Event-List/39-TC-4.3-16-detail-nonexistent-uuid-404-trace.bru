meta {
  name: TC-4.3-16 & WB-07 - UUID không tồn tại + X-Request-Id -> 404 NOT_FOUND
  type: http
  seq: 39
  tags: [
    event-list
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{nonExistentUuid}}
  body: none
  auth: bearer
}

headers {
  X-Request-Id: trace-list-01
}

auth:bearer {
  token: {{tokenSv001}}
}

tests {
  test("HTTP 404 và mã lỗi NOT_FOUND", function() {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("NOT_FOUND");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("traceId khớp X-Request-Id", function() {
    expect(res.getBody().traceId).to.equal("trace-list-01");
  });
}

docs {
  TC-4.3-16, TC-4.3-WB-07: UUID không tồn tại trả 404 ApiError kèm traceId chính xác.
}
