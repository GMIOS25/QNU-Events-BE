meta {
  name: TC-4.3-23 & WB-01 - Tham số sort field không tồn tại (ẩn stack trace)
  type: http
  seq: 31
  tags: [
    event-list
  ]
}

get {
  url: {{baseUrl}}/api/v1/events?sort=nonExistentField,asc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSv001}}
}

tests {
  test("Trả ApiError ẩn stack trace (500 theo code hiện tại hoặc 400 nếu đã xử lý PropertyReferenceException)", function() {
    expect([400, 500]).to.include(res.getStatus());
    expect(["VALIDATION_FAILED", "INTERNAL_ERROR"]).to.include(res.getBody().code);
    expect(JSON.stringify(res.getBody())).to.not.include("PropertyReferenceException");
  });
}

docs {
  TC-4.3-23, TC-4.3-WB-01/07: Kiểm tra xử lý ngoại lệ khi truyền sort field sai.
}
