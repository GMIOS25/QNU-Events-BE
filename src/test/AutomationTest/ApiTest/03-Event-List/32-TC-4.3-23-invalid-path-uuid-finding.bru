tests {
  test("Trả ApiError không lộ stack trace", function() {
    expect([400, 500]).to.include(res.getStatus());
    expect(["VALIDATION_FAILED", "INTERNAL_ERROR"]).to.include(res.getBody().code);
    expect(JSON.stringify(res.getBody())).to.not.include("IllegalArgumentException");
  });
}

