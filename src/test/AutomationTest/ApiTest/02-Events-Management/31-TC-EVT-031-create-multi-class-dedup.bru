meta {
  name: TC-EVT-031 - Gán đa lớp và khử trùng UUID [K49CNTT1, K49CNTT1, K49CNTT2]
  type: http
  seq: 31
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Sự kiện đa lớp",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{futureStartAt}}",
    "endAt": "{{futureEndAt}}",
    "registrationDeadline": "{{futureRegDeadline}}",
    "attendanceOpenAt": "{{futureAttOpen}}",
    "attendanceCloseAt": "{{futureAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 50,
    "audienceClassIds": [
      "{{classK49Cntt1}}",
      "{{classK49Cntt1}}",
      "{{classK49Cntt2}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("evtMultiDraftId", res.getBody().id);
  }
}

tests {
  test("HTTP 201 Created và lưu đúng 2 lớp duy nhất", function() {
    expect(res.getStatus()).to.equal(201);
    const ids = res.getBody().audienceClassIds;
    expect(ids).to.have.lengthOf(2);
    expect(ids).to.include(bru.getEnvVar("classK49Cntt1"));
    expect(ids).to.include(bru.getEnvVar("classK49Cntt2"));
  });
}

docs {
  TC-EVT-031 (EP-07-V2): Gán nhiều lớp cùng phần tử trùng lặp được Set khử trùng sạch sẽ.
}
