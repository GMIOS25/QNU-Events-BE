meta {
  name: TC-EVT-006 - BVA title đúng 3 ký tự ("AI1") -> 201 Created
  type: http
  seq: 6
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "AI1",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{futureStartAt}}",
    "endAt": "{{futureEndAt}}",
    "registrationDeadline": "{{futureRegDeadline}}",
    "attendanceOpenAt": "{{futureAttOpen}}",
    "attendanceCloseAt": "{{futureAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 50,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

tests {
  test("HTTP 201 Created tại biên dưới title = 3 ký tự", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().title).to.equal("AI1");
  });
}

docs {
  TC-EVT-006 (BVA-01): Biên hợp lệ tối thiểu 3 ký tự cho title.
}
