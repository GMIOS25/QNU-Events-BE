meta {
  name: TC-EVT-004 - Tạo sự kiện DRAFT bỏ trống mô tả (description = null) -> 201
  type: http
  seq: 3
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Sự kiện không mô tả",
    "description": null,
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{futureStartAt}}",
    "endAt": "{{futureEndAt}}",
    "registrationDeadline": "{{futureRegDeadline}}",
    "attendanceOpenAt": "{{futureAttOpen}}",
    "attendanceCloseAt": "{{futureAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 50,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

tests {
  test("HTTP 201 Created với description = null", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("DRAFT");
    expect(res.getBody().description).to.equal(null);
  });
}

docs {
  TC-EVT-004: Bỏ trống trường tùy chọn description vẫn cho phép tạo DRAFT.
}
