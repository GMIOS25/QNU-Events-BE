meta {
  name: TC-EVT-030 & WB-14 - POST /events body {} + X-Request-Id -> 400
  type: http
  seq: 26
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

headers {
  X-Request-Id: trace-evt-01
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {}
}

tests {
  test("HTTP 400 và mã lỗi VALIDATION_FAILED", function() {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("VALIDATION_FAILED");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("traceId khớp X-Request-Id và details.fields liệt kê đầy đủ trường thiếu", function() {
    const b = res.getBody();
    expect(b.traceId).to.equal("trace-evt-01");
    const fields = b.details.fields;
    expect(fields).to.include.all.keys("title", "location", "startAt", "endAt", "registrationDeadline", "attendanceOpenAt", "attendanceCloseAt", "quotaTotal", "audienceClassIds", "activityType");
  });
}

docs {
  TC-EVT-030, TC-EVT-WB-14: Body rỗng tổng hợp toàn bộ FieldError kèm traceId từ X-Request-Id.
}
