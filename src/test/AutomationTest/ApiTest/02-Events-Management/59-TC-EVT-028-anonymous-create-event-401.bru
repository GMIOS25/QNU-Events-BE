meta {
  name: TC-EVT-028 - Ẩn danh gọi POST /events -> 401 UNAUTHENTICATED
  type: http
  seq: 59
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: none
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Hội thảo AI & Khởi nghiệp 2026",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{futureStartAt}}",
    "endAt": "{{futureEndAt}}",
    "registrationDeadline": "{{futureRegDeadline}}",
    "attendanceOpenAt": "{{futureAttOpen}}",
    "attendanceCloseAt": "{{futureAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 50,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

tests {
  test("HTTP 401 và mã lỗi UNAUTHENTICATED", function() {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("UNAUTHENTICATED");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-EVT-028: Gọi POST /api/v1/events không token trả 401.
}
