meta {
  name: TC-EVT-026 - RBAC SYSTEM_ADMIN gọi POST /publish -> 403 FORBIDDEN
  type: http
  seq: 57
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events/{{evtDraftMainId}}/publish
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin01}}
}

body:json {
  {
    "confirm": true,
    "previewVersion": 2
  }
}

tests {
  test("HTTP 403 và mã lỗi FORBIDDEN", function() {
    expect(res.getStatus()).to.equal(403);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("FORBIDDEN");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-EVT-026: SYSTEM_ADMIN gọi /publish bị chặn 403 FORBIDDEN và ghi audit EVENT_PUBLISH_DENIED.
}
