meta {
  name: TC-EVT-030 - Bỏ trống attendanceMethod (null) mặc định DYNAMIC_QR -> 201
  type: http
  seq: 29
  tags: [
    events
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Default Method",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{futureStartAt}}",
    "endAt": "{{futureEndAt}}",
    "registrationDeadline": "{{futureRegDeadline}}",
    "attendanceOpenAt": "{{futureAttOpen}}",
    "attendanceCloseAt": "{{futureAttClose}}",
    "attendanceMethod": null,
    "quotaTotal": 50,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

tests {
  test("HTTP 201 Created và tự động gán attendanceMethod = DYNAMIC_QR", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().attendanceMethod).to.equal("DYNAMIC_QR");
  });
}

docs {
  TC-EVT-030 (EP-05-V2): Khi attendanceMethod là null, server mặc định DYNAMIC_QR.
}
