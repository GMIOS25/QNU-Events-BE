meta {
  name: [Setup] Tạo sự kiện evtHistNotChecked
  type: http
  seq: 7
  tags: [
    history
    setup
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Hist-2 Chưa Điểm Danh (+5đ)",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{laterStartAt}}",
    "endAt": "{{laterEndAt}}",
    "registrationDeadline": "{{laterRegDeadline}}",
    "attendanceOpenAt": "{{laterAttOpen}}",
    "attendanceCloseAt": "{{laterAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 10,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hoạt động tình nguyện",
    "activityPoints": 5
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("evtHistNotChecked", res.getBody().id);
}

tests {
  test("Setup tạo sự kiện evtHistNotChecked (201)", function() { expect(res.getStatus()).to.equal(201); });
}
