meta {
  name: [Setup] Lấy QR cho evtHistAccepted
  type: http
  seq: 5
  tags: [
    history
    setup
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtHistAccepted}}/qr
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("qrHistAccepted", res.getBody().token);
}

tests {
  test("Lấy QR evtHistAccepted (200)", function() { expect(res.getStatus()).to.equal(200); });
}
