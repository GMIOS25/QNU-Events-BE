meta {
  name: [Setup] Tạo sự kiện evtHistTieA
  type: http
  seq: 17
  tags: [
    history
    setup
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Hist-Tie-A (đăng ký trước)",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{tieStartAt}}",
    "endAt": "{{tieEndAt}}",
    "registrationDeadline": "{{tieRegDeadline}}",
    "attendanceOpenAt": "{{tieAttOpen}}",
    "attendanceCloseAt": "{{tieAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 10,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("evtHistTieA", res.getBody().id);
}

tests {
  test("Setup tạo sự kiện evtHistTieA (201)", function() { expect(res.getStatus()).to.equal(201); });
}
