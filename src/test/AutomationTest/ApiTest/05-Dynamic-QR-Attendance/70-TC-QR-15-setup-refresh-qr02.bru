meta {
  name: [Setup] Làm mới QR hợp lệ của evtQr02 cho TC-QR-15
  type: http
  seq: 70
  tags: [
    qr
    setup
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtQr02}}/qr
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner02}}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("qrToken02Fresh", res.getBody().token);
}

tests {
  test("Lấy QR evtQr02 thành công (200)", function() { expect(res.getStatus()).to.equal(200); });
}
