meta {
  name: TC-QR-03 - GET /qr ngoài cửa sổ điểm danh -> 409 ATTENDANCE_NOT_OPEN
  type: http
  seq: 37
  tags: [
    qr
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtQrClosed}}/qr
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

tests {
  test("HTTP 409 và mã lỗi ATTENDANCE_NOT_OPEN", function() {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("ATTENDANCE_NOT_OPEN");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Chưa đến hoặc đã hết thời gian điểm danh.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-QR-03: Không phát mã QR khi ngoài khoảng [attendanceOpenAt, attendanceCloseAt].
}
