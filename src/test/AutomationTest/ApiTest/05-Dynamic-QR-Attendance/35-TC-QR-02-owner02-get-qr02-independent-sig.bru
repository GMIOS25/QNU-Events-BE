meta {
  name: TC-QR-02 - Owner02 lấy mã QR cho evtQr02 -> chữ ký độc lập theo sự kiện
  type: http
  seq: 35
  tags: [
    qr
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtQr02}}/qr
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner02}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("qrToken02", res.getBody().token);
  }
}

tests {
  test("HTTP 200 OK và chữ ký HMAC của evtQr02 khác hoàn toàn evtQr01", function() {
    expect(res.getStatus()).to.equal(200);
    const parts = res.getBody().token.split(".");
    expect(parts[1]).to.equal(bru.getVar("evtQr02"));
    expect(parts[3]).to.not.equal(bru.getVar("qrSig01"));
  });
}

docs {
  TC-QR-02: Hai sự kiện khác nhau trong cùng khoảng thời gian phải sinh chữ ký QR hoàn toàn độc lập.
}
