  token: {{tokenSv002}}
}

body:json {
  {
    "token": "{{qrToken03Fresh}}"
  }
}

tests {
  test("HTTP 200 ACCEPTED chứng minh bộ đếm 3 lần độc lập theo cặp (event_id, student_id)", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}

