meta {
  name: TC-QR-15 & TC-QR-17 - Lần sai 1/3 (sv002): dùng QR hợp lệ của evtQr02 -> 422 QR_WRONG_EVENT
  type: http
  seq: 71
  tags: [
    qr
  ]
}

post {
  url: {{baseUrl}}/api/v1/events/{{evtQr01}}/attendance/qr
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idemKeyErrReplay}}
  X-Request-Id: req-qr-err-1
}

auth:bearer {
  token: {{tokenSv002}}
}

body:json {
  {
    "token": "{{qrToken02Fresh}}"
  }
}

script:pre-request {
  bru.setVar("idemKeyErrReplay", "bru-err-replay-" + Date.now());
}

script:post-response {
  bru.setVar("errReplayTimestamp", res.getBody().timestamp);
}

tests {
  test("HTTP 422 và mã lỗi QR_WRONG_EVENT", function() {
    expect(res.getStatus()).to.equal(422);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("QR_WRONG_EVENT");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Mã QR không thuộc về sự kiện này.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("traceId=req-qr-err-1 và attemptCount=1, remainingAttempts=2", function() {
    const b = res.getBody();
    expect(b.traceId).to.equal("req-qr-err-1");
    expect(b.details.attemptCount).to.equal(1);
    expect(b.details.remainingAttempts).to.equal(2);
    expect(b.details.canRetry).to.equal(true);
  });
}

docs {
  TC-QR-15, TC-QR-17: Token hợp lệ của sự kiện khác trả 422 QR_WRONG_EVENT và tính 1 lần thử sai.
}
