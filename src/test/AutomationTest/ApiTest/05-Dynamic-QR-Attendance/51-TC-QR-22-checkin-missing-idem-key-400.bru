meta {
  name: TC-QR-22 - Thiếu header Idempotency-Key -> 400 VALIDATION_FAILED
  type: http
  seq: 51
  tags: [
    qr
  ]
}

post {
  url: {{baseUrl}}/api/v1/events/{{evtQr01}}/attendance/qr
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSv001}}
}

body:json {
  {
    "token": "{{qrToken01}}"
  }
}

tests {
  test("HTTP 400 và mã lỗi VALIDATION_FAILED", function() {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("VALIDATION_FAILED");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Header Idempotency-Key là bắt buộc.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-QR-22 (BVA-05): Thiếu header Idempotency-Key trả 400 và không trừ lượt.
}
