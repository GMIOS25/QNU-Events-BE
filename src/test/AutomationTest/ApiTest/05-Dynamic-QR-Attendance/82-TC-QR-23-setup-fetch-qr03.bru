meta {
  name: [Setup] Lấy mã QR mới nhất của evtQr03
  type: http
  seq: 82
  tags: [
    qr
    setup
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtQr03}}/qr
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("qrToken03Fresh", res.getBody().token);
}

tests {
  test("Lấy QR evtQr03 (200)", function() { expect(res.getStatus()).to.equal(200); });
}
