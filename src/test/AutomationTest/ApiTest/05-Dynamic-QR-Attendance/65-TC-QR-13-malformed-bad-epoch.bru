meta {
  name: TC-QR-13 - QR_MALFORMED (epoch không phải số ("abc")) -> 422 & attemptCount=3
  type: http
  seq: 65
  tags: [
    qr
  ]
}

post {
  url: {{baseUrl}}/api/v1/events/{{evtQrMalB}}/attendance/qr
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{freshIdemKey}}
}

auth:bearer {
  token: {{tokenSv001}}
}

body:json {
  {
    "token": "qr1.{{evtQrMalB}}.abc.sig"
  }
}

tests {
  test("HTTP 422 và mã lỗi QR_MALFORMED", function() {
    expect(res.getStatus()).to.equal(422);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("QR_MALFORMED");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Mã QR không đúng định dạng.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("Metadata counted attempt chính xác: attemptCount=3, remaining=0", function() {
    const d = res.getBody().details;
    expect(d.attemptCount).to.equal(3);
    expect(d.maxAttempts).to.equal(3);
    expect(d.remainingAttempts).to.equal(0);
    expect(d.canRetry).to.equal(false);
  });
}

docs {
  TC-QR-13 (EP-08-I1): Kiểm tra phân vùng QR_MALFORMED cho trường hợp epoch không phải số ("abc").
}
