meta {
  name: TC-QR-14 & WB-04 - Token giả mạo event khác trả QR_BAD_SIGNATURE (trước QR_WRONG_EVENT)
  type: http
  seq: 69
  tags: [
    qr
  ]
}

post {
  url: {{baseUrl}}/api/v1/events/{{evtQrMalB}}/attendance/qr
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{freshIdemKey}}
}

auth:bearer {
  token: {{tokenSv002}}
}

body:json {
  {
    "token": "{{qrBadSigForgedOtherEvt}}"
  }
}

tests {
  test("HTTP 422 và mã lỗi QR_BAD_SIGNATURE", function() {
    expect(res.getStatus()).to.equal(422);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("QR_BAD_SIGNATURE");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Chữ ký mã QR không hợp lệ.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("attemptCount=3, canRetry=false (chứng minh verify chữ ký chạy trước kiểm tra eventId)", function() {
    expect(res.getBody().details.attemptCount).to.equal(3);
    expect(res.getBody().details.canRetry).to.equal(false);
  });
}

docs {
  TC-QR-14, TC-QR-WB-04: Token giả event khác với chữ ký sai phải trả QR_BAD_SIGNATURE (không lộ UUID).
}
