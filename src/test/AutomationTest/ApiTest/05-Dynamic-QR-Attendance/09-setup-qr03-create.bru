meta {
  name: [Setup] Tạo sự kiện evtQr03
  type: http
  seq: 9
  tags: [
    qr
    setup
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] QR-03 Active Isolation & 3rd Attempt",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{activeStartAt}}",
    "endAt": "{{activeEndAt}}",
    "registrationDeadline": "{{activeRegDeadline}}",
    "attendanceOpenAt": "{{activeAttOpen}}",
    "attendanceCloseAt": "{{activeAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 10,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("evtQr03", res.getBody().id);
}

tests {
  test("Setup tạo sự kiện evtQr03 (201)", function() { expect(res.getStatus()).to.equal(201); });
}
