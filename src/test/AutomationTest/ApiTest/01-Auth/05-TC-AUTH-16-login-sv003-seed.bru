meta {
  name: TC-AUTH-16 - Xác minh seed tài khoản sv003 (K49CNTT2)
  type: http
  seq: 5
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{sv003}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const b = res.getBody();
    bru.setVar("tokenSv003", b.accessToken);
    bru.setVar("sv003Id", b.user.id);
  }
}

tests {
  test("HTTP 200 OK cho sv003 lớp K49CNTT2", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.loginId).to.equal("sv003");
    expect(res.getBody().user.studentCode).to.equal("4901040003");
    expect(res.getBody().user.roles).to.deep.equal(["STUDENT"]);
    expect(res.getBody().user.classId).to.equal(bru.getEnvVar("classK49Cntt2"));
  });
}

docs {
  TC-AUTH-16: Kiểm tra dữ liệu seed DemoDataSeeder cho sv003.
}
