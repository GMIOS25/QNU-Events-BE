meta {
  name: TC-AUTH-04 - Login sai mật khẩu (owner01) -> 401 INVALID_CREDENTIALS
  type: http
  seq: 15
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{owner01}}",
    "password": "WrongPassword@123"
  }
}

script:post-response {
  const b = res.getBody();
  bru.setVar("authErrCodeWrongPass", b.code);
  bru.setVar("authErrMsgWrongPass", b.message);
  bru.setVar("authErrDetailsWrongPass", JSON.stringify(b.details || {}));
}

tests {
  test("HTTP 401 và mã lỗi INVALID_CREDENTIALS", function() {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("INVALID_CREDENTIALS");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Thông tin đăng nhập không chính xác.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("details rỗng và không lộ stack trace", function() {
    expect(res.getBody().details).to.deep.equal({});
  });
}

docs {
  TC-AUTH-04, TC-AUTH-13: Sai mật khẩu với tài khoản hợp lệ trả 401 INVALID_CREDENTIALS.
}
