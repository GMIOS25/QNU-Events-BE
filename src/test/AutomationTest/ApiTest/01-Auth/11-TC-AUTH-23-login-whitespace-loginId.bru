meta {
  name: TC-AUTH-23 & TC-AUTH-12 - Login loginId toàn khoảng trắng -> 400
  type: http
  seq: 11
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "   ",
    "password": "{{demoPassword}}"
  }
}

tests {
  test("HTTP 400 và mã lỗi VALIDATION_FAILED", function() {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("VALIDATION_FAILED");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Dữ liệu không hợp lệ.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });

  test("details.fields.loginId có thông báo lỗi tiếng Việt", function() {
    expect(res.getBody().details.fields.loginId).to.be.a("string").and.not.be.empty;
  });
}

docs {
  TC-AUTH-23, TC-AUTH-12: Kiểm định biên chuỗi khoảng trắng "   " cho loginId bị @NotBlank chặn 400.
}
