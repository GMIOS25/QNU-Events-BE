get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

tests {
  test("GET /actuator/health trả 200 UP công khai", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("UP");
  });
}

