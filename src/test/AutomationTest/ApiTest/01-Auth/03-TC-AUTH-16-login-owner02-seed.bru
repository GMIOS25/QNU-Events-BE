meta {
  name: TC-AUTH-16 - Xác minh seed tài khoản owner02 (EVENT_OWNER)
  type: http
  seq: 3
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{owner02}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const b = res.getBody();
    bru.setVar("tokenOwner02", b.accessToken);
    bru.setVar("owner02Id", b.user.id);
  }
}

tests {
  test("HTTP 200 OK cho owner02 với vai trò EVENT_OWNER", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.loginId).to.equal("owner02");
    expect(res.getBody().user.roles).to.deep.equal(["EVENT_OWNER"]);
    expect(res.getBody().user.classId).to.equal(null);
  });
}

docs {
  TC-AUTH-16: Kiểm tra dữ liệu seed DemoDataSeeder cho owner02.
}
