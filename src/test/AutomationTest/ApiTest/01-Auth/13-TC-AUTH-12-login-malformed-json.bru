meta {
  name: TC-AUTH-12 & WB-22 - Login JSON sai cú pháp -> 400
  type: http
  seq: 13
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {invalid
}

tests {
  test("HTTP 400 và mã lỗi VALIDATION_FAILED", function() {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("VALIDATION_FAILED");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Dữ liệu yêu cầu không hợp lệ hoặc sai định dạng.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-AUTH-12, TC-AUTH-WB-22: HttpMessageNotReadableException khi JSON sai cú pháp trả 400 VALIDATION_FAILED.
}
