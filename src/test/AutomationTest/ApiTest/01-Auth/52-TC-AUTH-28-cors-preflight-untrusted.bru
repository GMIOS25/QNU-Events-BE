meta {
  name: TC-AUTH-28 - CORS Preflight từ origin lạ -> 403 và không cấp Allow-Origin
  type: http
  seq: 52
  tags: [
    auth
  ]
}

options {
  url: {{baseUrl}}/api/v1/events
  body: none
  auth: none
}

headers {
  Origin: https://untrusted.example
  Access-Control-Request-Method: POST
  Access-Control-Request-Headers: authorization,content-type
}

tests {
  test("CORS preflight origin lạ bị chặn 403 và không có Access-Control-Allow-Origin", function() {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("access-control-allow-origin")).to.be.undefined;
  });
}

docs {
  TC-AUTH-28: CORS từ chối origin không nằm trong CORS_ALLOWED_ORIGINS.
}
