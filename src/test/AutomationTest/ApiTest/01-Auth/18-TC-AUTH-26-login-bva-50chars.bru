meta {
  name: TC-AUTH-26 - BVA loginId đúng 50 ký tự -> 401 (không 500)
  type: http
  seq: 18
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{loginId50}}",
    "password": "{{demoPassword}}"
  }
}

script:pre-request {
  bru.setVar("loginId50", "u".repeat(50));
}

tests {
  test("HTTP 401 và mã lỗi INVALID_CREDENTIALS", function() {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("INVALID_CREDENTIALS");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Thông tin đăng nhập không chính xác.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-AUTH-26 (BVA-02): loginId đúng biên 50 ký tự trả 401 INVALID_CREDENTIALS.
}
