}

get {
  url: {{baseUrl}}/v3/api-docs
  body: none
  auth: none
}

tests {
  test("GET /v3/api-docs mở trên profile dev (springdoc.api-docs.enabled=true)", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().openapi).to.match(/^3\./);
  });
}

docs {
