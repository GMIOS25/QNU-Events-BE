meta {
  name: TC-REG-08 - GET /registrations/me trước khi đăng ký -> 404 NOT_FOUND
  type: http
  seq: 14
  tags: [
    registration
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtRegE1}}/registrations/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSv001}}
}

tests {
  test("HTTP 404 và mã lỗi NOT_FOUND", function() {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("NOT_FOUND");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-REG-08: Tra cứu đăng ký cá nhân khi chưa đăng ký trả 404 NOT_FOUND.
}
