meta {
  name: [Setup] Tạo sự kiện evtRegE4
  type: http
  seq: 8
  tags: [
    registration
    setup
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOwner01}}
}

body:json {
  {
    "title": "[BRU-{{runSuffix}}] Reg E4 Quá Hạn",
    "description": "Nội dung chi tiết sự kiện kiểm thử tự động Bruno.",
    "location": "Hội trường A - Trường ĐH Quy Nhơn",
    "startAt": "{{expiredStartAt}}",
    "endAt": "{{expiredEndAt}}",
    "registrationDeadline": "{{expiredRegDeadline}}",
    "attendanceOpenAt": "{{expiredAttOpen}}",
    "attendanceCloseAt": "{{expiredAttClose}}",
    "attendanceMethod": "DYNAMIC_QR",
    "quotaTotal": 10,
    "audienceClassIds": [
      "{{classK49Cntt1}}"
    ],
    "activityType": "Hội thảo khoa học",
    "activityPoints": 5
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("evtRegE4", res.getBody().id);
}

tests {
  test("Setup tạo sự kiện evtRegE4 thành công (201)", function() { expect(res.getStatus()).to.equal(201); });
}
