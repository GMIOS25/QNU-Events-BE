meta {
  name: TC-4.3-10 - Xác minh sự kiện đầy 1/1 -> remainingQuota=0, registrationOpen=false
  type: http
  seq: 30
  tags: [
    registration
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtRegE2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSv002}}
}

tests {
  test("registeredCount=1, remainingQuota=0, registrationOpen=false", function() {
    expect(res.getStatus()).to.equal(200);
    const e = res.getBody();
    expect(e.registeredCount).to.equal(1);
    expect(e.remainingQuota).to.equal(0);
    expect(e.registrationOpen).to.equal(false);
  });
}

