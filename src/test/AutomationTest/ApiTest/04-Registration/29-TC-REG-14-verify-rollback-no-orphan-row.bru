meta {
  name: TC-REG-14 - Xác minh rollback: sv002 không còn dòng mồ côi trong registrations
  type: http
  seq: 29
  tags: [
    registration
  ]
}

get {
  url: {{baseUrl}}/api/v1/events/{{evtRegE2}}/registrations/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSv002}}
}

tests {
  test("HTTP 404 và mã lỗi NOT_FOUND", function() {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("NOT_FOUND");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-REG-14, TC-REG-WB-07: GET /me của sv002 trả 404 chứng minh rollback đã xóa sạch dòng INSERT tạm.
}
