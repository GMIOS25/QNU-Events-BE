meta {
  name: TC-4.6-15 & WB-04/05 - Kiểm tra PENDING/REJECTED trả NOT_CHECKED_IN & hành vi CANCELLED+REGISTERED
  type: http
  seq: 30
  tags: [
    db-fixture
  ]
}

get {
  url: {{baseUrl}}/api/v1/me/history?size=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSvHistEdge}}
}

tests {
  test("Sự kiện chỉ có attendances PENDING/REJECTED trả về đúng 1 dòng NOT_CHECKED_IN và ẩn attendanceAt", function() {
    expect(res.getStatus()).to.equal(200);
    const items = res.getBody().content;
    const pendingItems = items.filter((i) => i.eventId === bru.getEnvVar("brunoHistPendingEventId"));
    expect(pendingItems).to.have.lengthOf(1);
    expect(pendingItems[0].attendanceStatus).to.equal("NOT_CHECKED_IN");
    expect(Object.prototype.hasOwnProperty.call(pendingItems[0], "attendanceAt")).to.equal(false);
  });
  test("White-box Finding WB-05: sự kiện có cả CANCELLED và REGISTERED trả 2 dòng (REGISTERED trước CANCELLED)", function() {
    const items = res.getBody().content;
    const dupItems = items.filter((i) => i.eventId === bru.getEnvVar("brunoHistDupEventId"));
    expect(dupItems).to.have.lengthOf(2);
    expect(dupItems[0].registrationStatus).to.equal("REGISTERED");
    expect(dupItems[1].registrationStatus).to.equal("CANCELLED");
  });
}

docs {
  TC-4.6-15, TC-4.6-WB-04, TC-4.6-WB-05: Xác minh LEFT JOIN status=ACCEPTED loại trừ PENDING/REJECTED và ghi nhận hành vi không lọc r.status.
}
