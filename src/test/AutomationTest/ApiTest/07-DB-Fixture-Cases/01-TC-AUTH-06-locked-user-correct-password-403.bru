meta {
  name: TC-AUTH-06 - Đăng nhập tài khoản bị khóa (LOCKED) với mật khẩu đúng -> 403 FORBIDDEN
  type: http
  seq: 1
  tags: [
    db-fixture
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{brunoLockedUser}}",
    "password": "{{demoPassword}}"
  }
}

tests {
  test("HTTP 403 và mã lỗi FORBIDDEN", function() {
    expect(res.getStatus()).to.equal(403);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.code).to.equal("FORBIDDEN");
    expect(body.message).to.be.a("string").and.not.be.empty;
    expect(body.message).to.equal("Tài khoản của bạn đã bị khóa.");
    expect(body.traceId).to.be.a("string").and.not.be.empty;
    expect(body.timestamp).to.be.a("string").and.not.be.empty;
    expect(body.details).to.be.an("object");
  });
}

docs {
  TC-AUTH-06: Tài khoản status=LOCKED không được phép đăng nhập.
}
