meta {
  name: TC-QR-08 - Đăng nhập bruno_sv_waiting (có đăng ký WAITING_LIST)
  type: http
  seq: 23
  tags: [
    db-fixture
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{brunoSvWaiting}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("tokenSvWaiting", res.getBody().accessToken);
}

tests {
  test("Đăng nhập bruno_sv_waiting (200)", function() { expect(res.getStatus()).to.equal(200); });
}

docs {
  TC-QR-08: Chuẩn bị token cho sinh viên ở trạng thái WAITING_LIST.
}
