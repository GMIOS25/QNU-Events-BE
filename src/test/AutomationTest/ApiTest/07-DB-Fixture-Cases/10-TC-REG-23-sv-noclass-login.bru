meta {
  name: TC-REG-23 - Đăng nhập sinh viên không có lớp (class_id=NULL) -> 200
  type: http
  seq: 10
  tags: [
    db-fixture
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "{{brunoSvNoClass}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("tokenSvNoClass", res.getBody().accessToken);
}

tests {
  test("HTTP 200 OK với roles=[STUDENT] và classId=null", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.roles).to.deep.equal(["STUDENT"]);
    expect(res.getBody().user.classId).to.equal(null);
  });
}

docs {
  TC-REG-23, TC-4.3-WB-02: Đăng nhập sinh viên có class_id=NULL.
}
