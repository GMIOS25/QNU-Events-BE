tests {
  test("HTTP 200 OK với content=[] và totalElements=0", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content).to.deep.equal([]);
    expect(res.getBody().totalElements).to.equal(0);
  });
}

