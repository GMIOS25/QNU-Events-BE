# Development only. Copy to .env; the application and Docker Compose read it.
DB_NAME=qnu_events
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/qnu_events
DB_USERNAME=qnu_events
DB_PASSWORD=qnu_events_dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB

# JWT Authentication (Sprint 1)
JWT_SECRET=qnu-events-dev-secret-key-must-be-at-least-256-bits-long-for-hmac-sha256!
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=28800

# Dynamic QR Token (Sprint 1)
QR_SIGNING_SECRET=qnu-events-qr-hmac-secret-dev-key-at-least-256-bits-long-for-security!
QR_EPOCH_SECONDS=15
QR_GRACE_PERIOD_SECONDS=3

# Demo Data Seeding
DEMO_PASSWORD=Demo@12345
SEED_DEMO_DATA=true
