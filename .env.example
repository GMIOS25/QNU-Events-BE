# Development only. Copy to .env; the application and Docker Compose read it.
DB_NAME=qnu_events
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/qnu_events
DB_USERNAME=qnu_events
DB_PASSWORD=qnu_events_dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB
# Codespaces supplies its own DB_URL pointing to the postgres service.
# Google credentials and allowed university domains will be added with the auth feature.
